# Copy to .env before `docker compose up -d --build`
JWT_SECRET=change-me-in-production
# URL the browser uses to reach the API (must be reachable from the user's device)
PUBLIC_API_URL=http://localhost:8044
CORS_ORIGINS=http://localhost:3044,http://127.0.0.1:3044
# 1 = the OTP is returned by the API for demos, 0 = production behaviour
EXPOSE_OTP=1
