# Copy to .env, then: docker compose up -d --build
# docker compose refuses to start until JWT_SECRET is set.

# Required. At least 32 characters and never a published default. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out and invalidates pending login codes.
JWT_SECRET=

# 0 = production behaviour. 1 = demo: login codes are returned by the API (dev_code), the demo
# partner 09120000000 is seeded and orders are paid instantly. NEVER set 1 on a public host.
DEMO_MODE=0

# Set 1 once the site is served over HTTPS: the session cookie gets the Secure flag and the API
# sends Strict-Transport-Security. Leave 0 for plain http://localhost, or the browser drops the cookie.
COOKIE_SECURE=0

# Browser origins allowed to call the API (comma separated, no trailing slash). Every unsafe request
# carries an Origin header that must be listed here, so include the public web URL.
CORS_ORIGINS=http://localhost:3044,http://127.0.0.1:3044

# Interface the published ports bind to. Keep loopback and let a TLS reverse proxy face the internet.
BIND_ADDR=127.0.0.1

# Rate limits are per client IP, taken TRUSTED_PROXIES entries from the right of X-Forwarded-For.
# The web container's /api rewrite forwards that header untouched and adds no entry of its own, so the
# entry must come from the TLS reverse proxy in front of it: have that proxy SET the header to the peer
# address (nginx: proxy_set_header X-Forwarded-For $remote_addr;) and keep 1. Do not raise it to 2 for
# that proxy: the extra entry would be one the client wrote. Without such a proxy every visitor shares
# the web container's budget and a client can pick its own bucket. 0 = ignore the header.
TRUSTED_PROXIES=1

# Optional. Send Strict-Transport-Security from the web app (only behind HTTPS).
ENABLE_HSTS=0
# Optional. development | test | production (default). Only change it on a developer machine.
# APP_ENV=production
